+def corridor_enclosed(points, minimum_support=8):
+    """Return True when LiDAR sees sustained close boundaries on both sides.
+
+    This is a local geometry predicate, not a tunnel/map detector.  It is used
+    only after an observed tunnel sign to keep a safe LiDAR planner alive when
+    darkness temporarily removes all camera lane evidence.
+    """
+    if points is None:
+        return False
+    points = _external_points(points)
+    if points is None or len(points) < 2*minimum_support:
+        return False
