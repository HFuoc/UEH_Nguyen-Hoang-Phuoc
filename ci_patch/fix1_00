+def _external_points(points):
+    """Defensively remove impossible returns inside the Waffle footprint."""
+    if points is None:
+        return None
+    points = np.asarray(points, dtype=float)
+    if not len(points):
+        return points.reshape((-1, 2))
+    own = (((points[:, 0] >= -.225) & (points[:, 0] <= .105)
+            & (np.abs(points[:, 1]) <= .158))
+           | ((np.abs(points[:, 0]) <= .055)
+              & (np.abs(points[:, 1]) <= .172)))
+    return points[~own]
+
