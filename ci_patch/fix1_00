+def _robust_wall(points, side):
+    """Fit one nearby wall line y=a*x+b with deterministic consensus."""
+    if points is None or not len(points):
+        return None
+    points = _external_points(points)
+    x, y = points[:, 0], points[:, 1]
+    sign = 1. if side > 0 else -1.
+    mask = ((x > -.08) & (x < .72)
+            & (sign*y > .17) & (sign*y < .75))
+    sample = points[mask]
+    if len(sample) < 5:
+        return None
+    if len(sample) > 48:
+        order = np.argsort(sample[:, 0])
+        sample = sample[order[np.linspace(0, len(order)-1, 48).astype(int)]]
+    sx, sy = sample[:, 0], sample[:, 1]
+    best = None
+    n = len(sample)
+    for i in range(n-1):
+        for j in range(i+1, n):
+            dx = sx[j]-sx[i]
+            if abs(dx) < .10:
+                continue
+            a = (sy[j]-sy[i])/dx
+            if abs(a) > 2.5:
+                continue
+            b = sy[i]-a*sx[i]
+            residual = np.abs(sy-(a*sx+b))
+            keep = residual < .035
+            count = int(np.count_nonzero(keep))
+            if count < 5:
+                continue
+            span = float(np.ptp(sx[keep]))
+            if span < .18:
+                continue
+            median = float(np.median(residual[keep]))
+            score = count + 2.0*span - 8.0*median
+            if best is None or score > best[0]:
+                best = (score, keep)
+    if best is None:
+        return None
+    keep = best[1]
+    a, b = np.polyfit(sx[keep], sy[keep], 1)
+    residual = float(np.median(np.abs(sy[keep]-(a*sx[keep]+b))))
+    span = float(np.ptp(sx[keep]))
+    return float(a), float(b), int(np.count_nonzero(keep)), span, residual
